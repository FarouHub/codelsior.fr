---
import projects from "../collections/projects.json";
import CtaBanner from "../components/landing/cta-banner.astro";
import PageHeading from "../components/page-heading.astro";
import Project from "../components/project.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title="Mes réalisations - Codelsior"
  description="Marketplaces SaaS en production, migrations e-commerce, outils métier : une sélection des projets que j'ai conçus, développés et hébergés."
>
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="Mes réalisations"
      description="Des plateformes que je fais tourner au quotidien et des migrations menées pour des e-commerçants. Les 10 marketplaces Bonjour Fun reposent sur une même plateforme SaaS multi-tenant que je développe, avec l'IA, et que j'héberge."
    />

    <div
      class="z-50 grid items-stretch w-full grid-cols-1 my-8 gap-7 sm:gap-5 sm:grid-cols-2"
    >
      {
        projects.map((project) => {
          return (
            <Project
              name={project.name}
              description={project.description}
              image={project.image}
              url={project.url}
            />
          )
        })
      }
    </div>
  </section>
  <CtaBanner title="Votre projet pourrait être le prochain." />
</Layout>
