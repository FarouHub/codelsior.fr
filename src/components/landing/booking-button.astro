---
import { booking, bookingCalLink, bookingUrl } from "../../config";

interface Props {
	event?: string;
	text?: string;
	variant?: "primary" | "secondary";
	class?: string;
}

const {
	event = booking.defaultEvent,
	text = "Réserver un appel découverte",
	variant = "primary",
	class: className,
} = Astro.props;

const variants = {
	primary:
		"bg-brand text-white border-brand hover:bg-brand-light hover:border-brand-light dark:bg-accent dark:text-brand dark:border-accent dark:hover:bg-white dark:hover:border-white",
	secondary:
		"bg-white text-neutral-900 border-neutral-300 hover:border-neutral-900 dark:bg-neutral-950 dark:text-white dark:border-neutral-700 dark:hover:border-white",
};
---

<a
  href={bookingUrl(event)}
  target="_blank"
  rel="noopener"
  data-cal-link={bookingCalLink(event)}
  data-cal-config='{"layout":"month_view"}'
  data-umami-event="prise-rdv"
  data-umami-event-type={event}
  class:list={[
    "inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-semibold duration-300 ease-out border rounded-full",
    variants[variant],
    className,
  ]}
>
  <svg
    class="w-4 h-4"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    aria-hidden="true"
    ><path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
    ></path></svg
  >
  {text}
</a>
