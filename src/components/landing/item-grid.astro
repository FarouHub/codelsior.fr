---
import type { Item } from "../../collections/services";

interface Props {
	items: Item[];
	numbered?: boolean;
	tone?: "default" | "pain";
}

const { items, numbered = false, tone = "default" } = Astro.props;
const columns =
	items.length % 3 === 0 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2";
---

<div class:list={["grid grid-cols-1 gap-5", columns]}>
  {
    items.map((item, index) => (
      <div
        class:list={[
          "relative p-6 border rounded-2xl",
          tone === "pain"
            ? "border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900"
            : "border-dashed border-neutral-300 bg-white dark:border-neutral-700 dark:bg-neutral-950",
        ]}
      >
        {numbered && (
          <span class="flex items-center justify-center mb-3 text-sm font-bold rounded-full w-8 h-8 bg-brand text-white dark:bg-accent dark:text-brand">
            {index + 1}
          </span>
        )}
        <h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100">
          {item.title}
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          {item.text}
        </p>
      </div>
    ))
  }
</div>
