---
import { families, servicesOf } from "../../collections/services";
import ServiceCard from "./service-card.astro";
---

<div class="space-y-12">
  {
    families.map((family) => (
      <div>
        <div class="flex flex-col mb-5 sm:flex-row sm:items-baseline sm:gap-3">
          <h3 class="text-lg font-bold text-brand dark:text-accent">
            {family.name}
          </h3>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">
            {family.tagline}
          </p>
        </div>
        <div
          class:list={[
            "grid grid-cols-1 gap-5",
            servicesOf(family.id).length > 1 && "sm:grid-cols-2",
          ]}
        >
          {servicesOf(family.id).map((service) => (
            <ServiceCard service={service} />
          ))}
        </div>
      </div>
    ))
  }
</div>
