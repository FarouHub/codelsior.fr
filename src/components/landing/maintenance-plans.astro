---
import { maintenancePlans } from "../../collections/services";
import CheckList from "./check-list.astro";
import SectionTitle from "./section-title.astro";
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <SectionTitle
    eyebrow="Après la livraison"
    title="Je construis, j'héberge, je maintiens."
    description="Vous ne voulez pas gérer de serveur ? J'héberge et je maintiens l'application que je vous ai livrée, en Europe, avec un interlocuteur qui connaît le code."
  />
  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    {
      maintenancePlans.map((plan, index) => (
        <div
          class:list={[
            "p-6 border rounded-2xl bg-white dark:bg-neutral-950",
            index === 1
              ? "border-brand border-2 dark:border-accent"
              : "border-neutral-200 dark:border-neutral-800",
          ]}
        >
          <p class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">
            {plan.name}
          </p>
          <p class="mt-1 mb-5 text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {plan.price}
            <span class="text-sm font-medium text-neutral-500"> HT / mois</span>
          </p>
          <CheckList items={plan.features} />
        </div>
      ))
    }
  </div>
  <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
    Engagement 12 mois. Formule Essentiel offerte 3 mois pour les premiers
    clients. Uniquement pour les applications que je développe.
  </p>
</section>
