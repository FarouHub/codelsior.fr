---
import { primaryServices, secondaryServices } from "../../collections/services";
import ServiceCard from "./service-card.astro";
---

<div class="space-y-5">
  <div class="grid items-stretch grid-cols-1 gap-5 sm:grid-cols-2">
    {primaryServices.map((service) => <ServiceCard service={service} />)}
  </div>
  {
    secondaryServices.length > 0 && (
      <div class="space-y-3">
        {secondaryServices.map((service) => (
          <ServiceCard service={service} compact />
        ))}
      </div>
    )
  }
</div>
