---
import menus from "../collections/menu.json";
import { families, servicesOf, serviceUrl } from "../collections/services";
import BookingButton from "../components/landing/booking-button.astro";
import Logo from "../components/logo.astro";
---

<!-- This is an invisible div with relative position so that it takes up the height of the menu (because menu is absolute/fixed) -->
<div class="relative w-full h-20 opacity-0 pointer-events-none"></div>
<header id="header" class="absolute top-0 z-50 w-full h-20">
  <div
    class="flex items-center justify-between h-full max-w-5xl pl-6 pr-4 mx-auto border-b border-l-0 border-r-0 border-transparent select-none lg:border-r lg:border-l lg:rounded-b-xl"
  >
    <Logo />
    <div
      id="mobileMenuBackground"
      onclick="closeMobileMenu()"
      class="fixed inset-0 z-20 hidden w-screen h-screen duration-300 ease-out bg-white/90 dark:bg-neutral-950/90"
    >
    </div>
    <nav
      class="relative z-30 flex flex-row-reverse justify-start w-full text-sm md:justify-end text-neutral-500 dark:text-neutral-400 md:flex-row"
    >
      <div
        id="openMenu"
        class="flex flex-col items-end justify-center w-6 h-6 ml-4 cursor-pointer md:hidden"
      >
        <svg
          class="w-8 h-8 dark:text-neutral-200"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"><path d="M4 8h16M4 16h16"></path></svg
        >
      </div>

      <div
        id="closeMenu"
        class="flex flex-col items-end justify-center w-6 h-6 ml-4 -translate-x-1 cursor-pointer md:hidden"
      >
        <svg
          class="w-6 h-6 text-neutral-600 dark:text-neutral-200"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"><path d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </div>
      <div
        id="menu"
        class="fixed top-[75px] ease-out duration-300 md:top-0 w-full left-0 md:py-0 pt-7 pb-4 dm:mx-0 z-40 flex-col items-end justify-start hidden h-auto text-sm md:text-base md:h-auto md:relative md:flex-row md:flex md:w-auto md:pr-0 md:pt-0"
      >
        <div
          class="absolute inset-0 top-0 right-0 block w-full h-full px-3 md:hidden"
        >
          <div
            class="relative w-full h-full bg-white border border-dashed border-neutral-300 dark:border-neutral-700 backdrop-blur-sm rounded-xl dark:bg-neutral-950"
          >
          </div>
        </div>
        {
          menus.map((menu) => {
            const link = (
              <a
                href={menu.url}
                class="relative flex items-center justify-center w-full px-3 py-2 font-medium tracking-wide text-center duration-200 ease-out md:py-0 md:mb-0 md:w-auto hover:text-neutral-900 dark:hover:text-white"
              >
                {menu.name}
              </a>
            )
            if (menu.url !== "/services") return link
            // Sous-menu des services : liste à plat sur mobile, panneau
            // déroulant au survol sur desktop.
            return (
              <div class="relative w-full group md:w-auto">
                {link}
                <div class="md:absolute md:left-1/2 md:-translate-x-1/2 md:top-full md:pt-4 md:hidden md:group-hover:block md:group-focus-within:block">
                  <div class="pb-2 md:w-80 md:p-3 md:bg-white md:border md:shadow-xl md:dark:bg-neutral-950 md:rounded-xl md:border-neutral-200 md:dark:border-neutral-800">
                    {families.map((family) => (
                      <div>
                        <p class="hidden px-3 pt-2 pb-1 text-[0.65rem] font-semibold tracking-widest uppercase md:block text-accent-dark dark:text-accent">
                          {family.name}
                        </p>
                        {servicesOf(family.id).map((service) => (
                          <a
                            href={serviceUrl(service)}
                            class="block px-3 py-1.5 text-xs text-center md:text-sm md:text-left rounded-lg md:hover:bg-neutral-100 md:dark:hover:bg-neutral-900 hover:text-neutral-900 dark:hover:text-white"
                          >
                            {service.menuLabel}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )
          })
        }
        <div class="relative flex justify-center w-full pt-3 md:hidden">
          <BookingButton text="Prendre RDV" />
        </div>
      </div>
      <BookingButton
        text="Prendre RDV"
        class="hidden! md:inline-flex! px-4! py-2! ml-4 text-xs! whitespace-nowrap"
      />
      <div
        id="darkToggle"
        class="relative flex items-center pl-6 ml-4 font-medium tracking-wide cursor-pointer text-neutral-800 group dark:text-white"
      >
        <div
          class="absolute left-0 flex items-center justify-center w-6 h-6 overflow-hidden border-b border-transparent horizon group-hover:border-neutral-600"
        >
          <svg
            class="absolute w-6 h-6 transition duration-700 transform ease"
            id="sun"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path></svg
          >
          <svg
            class="absolute hidden w-6 h-6 transition duration-700 transform ease"
            id="moon"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path></svg
          >
        </div>
        <span class="hidden xl:inline-block">
          <span id="dayText" class="ml-2">Mode clair</span>
          <span id="nightText" class="hidden ml-2">Mode nuit</span>
        </span>
      </div>
    </nav>
  </div>
</header>
