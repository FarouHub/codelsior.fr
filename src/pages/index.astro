---
import experiences from "../collections/experiences.json";
import { services, serviceUrl } from "../collections/services";
import Projects from "../components/home/projects.astro";
import Separator from "../components/home/separator.astro";
import Writings from "../components/home/writings.astro";
import BookingButton from "../components/landing/booking-button.astro";
import CtaBanner from "../components/landing/cta-banner.astro";
import Families from "../components/landing/families.astro";
import ItemGrid from "../components/landing/item-grid.astro";
import SectionTitle from "../components/landing/section-title.astro";
import Testimonials from "../components/landing/testimonials.astro";
import { site } from "../config";
import Layout from "../layouts/main.astro";

const stats = [
	{ value: "15 ans", label: "d'expérience en développement" },
	{ value: "10", label: "marketplaces en production" },
	{ value: "100 %", label: "du code livré vous appartient" },
	{ value: "FR · UE", label: "hébergement en France ou en Europe" },
];

// Une seule entrée par entreprise (PSA apparaît deux fois dans le parcours).
const companies = [
	...new Map(
		experiences.map((experience) => [experience.logo, experience]),
	).values(),
].map((experience) => ({
	name: experience.company.split(" · ")[0],
	logo: experience.logo,
}));

const aiPillars = [
	{
		title: "Plus vite",
		text: "Ce qui demandait des mois se livre en quelques semaines. Vous testez votre outil avant même d'avoir fini d'en parler.",
	},
	{
		title: "Moins cher",
		text: `Pas d'agence à financer, et l'IA qui absorbe les tâches répétitives : ${site.savingsClaim}.`,
	},
	{
		title: "Sans rogner sur la qualité",
		text: "Un développeur senior conçoit l'architecture, relit et teste. L'IA est un accélérateur, pas un pilote automatique.",
	},
];

const steps = [
	{
		title: "Appel découverte gratuit",
		text: "30 minutes pour comprendre votre besoin. Vous repartez avec un avis franc et un ordre de prix.",
	},
	{
		title: "Une offre de démarrage à prix fixe",
		text: "Prototype, audit ou diagnostic : un premier livrable concret, sans engagement sur la suite.",
	},
	{
		title: "Réalisation et suivi",
		text: "Livraisons régulières, code et documentation remis, hébergement et maintenance si vous le souhaitez.",
	},
];

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "ProfessionalService",
		name: site.name,
		url: site.url,
		email: site.email,
		image: `${site.url}/assets/images/nicolas-codelsior.jpg`,
		founder: { "@type": "Person", name: site.owner },
		address: {
			"@type": "PostalAddress",
			addressLocality: "Mulhouse",
			addressRegion: "Alsace",
			addressCountry: "FR",
		},
		areaServed: "FR",
		makesOffer: services.map((service) => ({
			"@type": "Offer",
			itemOffered: {
				"@type": "Service",
				name: service.menuLabel,
				url: `${site.url}${serviceUrl(service)}`,
			},
		})),
	},
];
---

<Layout
  title="Codelsior · Développeur freelance senior augmenté par l'IA"
  description={`Logiciel sur mesure, automatisation IA, souveraineté numérique, renfort d'équipe et DevOps : le projet que vous repoussez devient réalisable, ${site.savingsClaim}. Freelance en Alsace, partout en France.`}
  jsonLd={jsonLd}
>
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-12 px-7 md:mt-20 lg:mt-24 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-3/5">
        <p
          class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-xs font-medium border rounded-full text-neutral-600 border-neutral-200 bg-white dark:bg-neutral-950 dark:text-neutral-300 dark:border-neutral-800"
        >
          <span class="relative flex w-2 h-2">
            <span
              class="absolute inline-flex w-full h-full rounded-full opacity-75 animate-ping bg-accent"
            ></span>
            <span
              class="relative inline-flex w-2 h-2 rounded-full bg-accent-dark"
            ></span>
          </span>
          {site.availability} · {site.area}
        </p>
        <h1
          class="mb-6 text-4xl font-bold leading-tight tracking-tight lg:text-5xl dark:text-white"
        >
          Ce projet que vous repoussez depuis des années ?
          <span
            class="text-transparent bg-linear-to-r from-accent-dark to-brand bg-clip-text dark:from-accent dark:to-sky-300"
            >Avec l'IA, il devient réalisable.</span
          >
        </h1>
        <p
          class="mb-8 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400"
        >
          Développeur senior augmenté par l'IA, je construis, automatise et
          héberge vos outils numériques, <strong
            class="font-semibold text-neutral-900 dark:text-white"
            >{site.savingsClaim}</strong
          >.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <BookingButton />
          <a
            href="#services"
            class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold duration-300 ease-out border rounded-full border-neutral-300 text-neutral-900 hover:border-neutral-900 dark:border-neutral-700 dark:text-white dark:hover:border-white"
          >
            Voir mes services
          </a>
        </div>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-2/5 md:mt-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute top-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
                >👋</span
              >
            </span>
          </div>
          <img
            src="/assets/images/nicolas-codelsior.jpg"
            alt={site.owner}
            loading="eager"
            decoding="auto"
            class="relative z-30 w-full mx-auto md:max-w-md rounded-2xl"
          />
        </div>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-6 mt-16 md:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="pl-4 border-l-2 border-accent">
            <dt class="text-2xl font-bold text-neutral-900 dark:text-white">
              {stat.value}
            </dt>
            <dd class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
              {stat.label}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-14">
      <p
        class="mb-4 text-xs font-semibold tracking-widest text-center uppercase text-neutral-400"
      >
        Ils m'ont fait confiance au fil de mon parcours
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        {
          companies.map((company) => (
            <li class="flex items-center gap-2 text-sm font-medium duration-300 text-neutral-500 grayscale hover:grayscale-0 dark:text-neutral-400">
              <img
                src={company.logo}
                alt=""
                class="w-8 h-8 rounded-full"
                loading="lazy"
              />
              {company.name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Separator text="Mes services" />
  <section id="services" class="relative z-20 max-w-4xl mx-auto scroll-mt-24 px-7 lg:px-0">
    <SectionTitle
      title="Comment je peux vous aider"
      description="Cinq services, trois familles. Chacun commence par un appel gratuit et une offre de démarrage à prix fixe."
    />
    <Families />
  </section>

  <Separator text="Pourquoi l'IA change tout" />
  <section class="relative z-20 max-w-4xl mx-auto px-7 lg:px-0">
    <SectionTitle
      title="Les projets qu'on n'osait pas lancer deviennent abordables."
      description="Je développe aujourd'hui Bonjour Fun avec l'IA : une plateforme SaaS qui fait tourner 10 marketplaces en production. Cette méthode, je la mets au service de vos projets."
    />
    <ItemGrid items={aiPillars} />
    <a
      href="/services/projet-sur-mesure-ia"
      class="inline-block mt-6 text-sm font-semibold text-brand dark:text-accent hover:underline"
    >
      Voir la comparaison avec une agence →
    </a>
  </section>

  <Separator text="Méthode" />
  <section class="relative z-20 max-w-4xl mx-auto px-7 lg:px-0">
    <SectionTitle title="Simple, transparent, sans engagement" />
    <ItemGrid items={steps} numbered />
  </section>

  <div class="relative z-20 mt-24">
    <Testimonials />
  </div>

  <Separator text="Mes réalisations" />
  <Projects />
  <Separator text="Mes derniers articles" />
  <Writings />

  <div class="relative z-20 mt-24">
    <CtaBanner />
  </div>
</Layout>
