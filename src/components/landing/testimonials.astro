---
import { testimonials } from "../../collections/testimonials";
import SectionTitle from "./section-title.astro";

interface Props {
	service?: string;
}

const { service } = Astro.props;
const items = testimonials.filter(
	(testimonial) =>
		!service ||
		testimonial.services.length === 0 ||
		testimonial.services.includes(service),
);
---

{
  items.length > 0 && (
    <section class="max-w-4xl mx-auto px-7 lg:px-0">
      <SectionTitle eyebrow="Témoignages" title="Ils m'ont fait confiance" />
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {items.map((testimonial) => (
          <figure class="p-6 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-700">
            <blockquote class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
              « {testimonial.quote} »
            </blockquote>
            <figcaption class="flex items-center gap-3 mt-4">
              {testimonial.photo && (
                <img
                  src={testimonial.photo}
                  alt={testimonial.name}
                  class="w-10 h-10 rounded-full object-cover"
                />
              )}
              <span>
                <span class="block text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                  {testimonial.name}
                </span>
                <span class="block text-xs text-neutral-500">
                  {testimonial.role}
                </span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}
