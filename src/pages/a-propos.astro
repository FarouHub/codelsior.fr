---
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import CtaBanner from "../components/landing/cta-banner.astro";
import PageHeading from "../components/page-heading.astro";
import { site } from "../config";
import Layout from "../layouts/main.astro";
---

<Layout
  title="À propos de Nicolas Sittler - Codelsior"
  description="Développeur senior depuis 15 ans, CTO et co-fondateur de Bonjour Fun : mon parcours, de l'ERP de PSA aux marketplaces SaaS développées avec l'IA."
>
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="À propos"
      description="Hello 👋 Je suis Nicolas, CTO et co-fondateur de Bonjour Fun, développeur senior avec plus de 15 ans d'expérience en développement logiciel et en gestion de projets SI. Aujourd'hui, je mets cette expérience et le développement assisté par l'IA au service de vos projets."
    />

    <img src="/assets/images/about.jpg" class="relative z-30 w-full my-10 rounded-xl" />

    <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">Mes technos</h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      Symfony, PHP, Java, Docker, DevOps — du back-end métier au déploiement, en passant par l'e-commerce et les architectures SaaS.
    </p>

    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      Expériences
    </h2>
    <div class="px-5 py-10">
      {
        experiences.map((experience) => {
          return (
            <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
              <AboutExperience
                dates={experience.dates}
                role={experience.role}
                company={experience.company}
                description={experience.description}
                logo={experience.logo}
              />
            </div>
          )
        })
      }
    </div>

    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200">Travaillons ensemble</h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      {site.availability}, en remote ou sur site en Alsace. Découvrez <a
        href="/services"
        class="underline text-brand dark:text-accent">mes services</a
      >, écrivez-moi à <a
        href={`mailto:${site.email}`}
        class="underline text-brand dark:text-accent">{site.email}</a
      > ou suivez-moi sur <a
        href="https://x.com/nisittler"
        target="_blank"
        class="underline text-brand dark:text-accent">X</a
      >.
    </p>
  </section>
  <CtaBanner />
</Layout>
