---
import type { Offer } from "../../collections/services";
import { site } from "../../config";
import BookingButton from "./booking-button.astro";
import CheckList from "./check-list.astro";

interface Props {
	offers: Offer[];
	event: string;
	ctaText?: string;
}

const {
	offers,
	event,
	ctaText = "Réserver un échange de 30 min",
} = Astro.props;
---

<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
  {
    offers.map((offer, index) => (
      <div
        class:list={[
          "flex flex-col p-6 bg-white border rounded-2xl dark:bg-neutral-950",
          index === 0
            ? "border-2 border-brand dark:border-accent"
            : "border-neutral-200 dark:border-neutral-800",
        ]}
      >
        <p class="text-xs font-semibold tracking-widest uppercase text-accent-dark dark:text-accent">
          {offer.duration}
        </p>
        <h3 class="mt-2 text-lg font-bold text-neutral-900 md:min-h-14 dark:text-neutral-100">
          {offer.name}
        </h3>
        <p
          class:list={[
            "mt-4 font-bold whitespace-nowrap text-neutral-900 dark:text-white",
            offer.price.length > 12
              ? "text-xl"
              : offer.price.length > 8
                ? "text-2xl"
                : "text-3xl",
          ]}
        >
          {offer.price}
          <span class="text-sm font-medium text-neutral-500"> HT</span>
        </p>
        {offer.priceDetail && (
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
            {offer.priceDetail}
          </p>
        )}
        <CheckList items={offer.includes} class="mt-5 grow" />
        {offer.note && (
          <p class="mt-4 text-xs font-medium text-accent-dark dark:text-accent">
            {offer.note}
          </p>
        )}
      </div>
    ))
  }
</div>
<div
  class="flex flex-col items-center gap-3 mt-8 sm:flex-row sm:justify-center"
>
  <BookingButton event={event} text={ctaText} />
  <a
    href={`mailto:${site.email}`}
    class="text-sm font-medium underline text-neutral-600 underline-offset-4 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
  >
    ou écrivez-moi : {site.email}
  </a>
</div>
